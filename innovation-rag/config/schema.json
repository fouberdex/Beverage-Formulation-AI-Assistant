{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BeverageDzAI innovation RAG configuration",
  "type": "object",
  "required": ["scope", "ingestion", "preprocessing", "indexing", "retrieval", "generation"],
  "properties": {
    "scope": {
      "type": "object",
      "required": ["domain", "themes", "languages", "date_from", "date_to", "patents"]
    },
    "ingestion": {
      "type": "object",
      "required": ["enabled_sources", "pilot_limit_total", "per_source_limit", "output_dir"]
    },
    "preprocessing": {
      "type": "object",
      "required": ["input_dir", "output_file", "chunk_size_words", "chunk_overlap_words"]
    },
    "indexing": {
      "type": "object",
      "required": ["qdrant_url", "collection_name", "dense_model", "sparse_model"]
    },
    "retrieval": {
      "type": "object",
      "required": ["dense_candidates", "sparse_candidates", "top_k"]
    },
    "generation": {
      "type": "object",
      "required": ["provider", "model", "base_url"]
    },
    "evidence_policy_file": {
      "type": ["string", "null"]
    },
    "chemistry_rules_file": {
      "type": ["string", "null"]
    }
  },
  "additionalProperties": false
}
