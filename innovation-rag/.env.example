# BigQuery public patents dataset (required only for patent ingestion)
GCP_PROJECT_ID=your-google-cloud-project
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json
BIGQUERY_MAX_BYTES_BILLED=5000000000

# Optional API identity / higher-rate access
OPENALEX_EMAIL=you@example.com
SEMANTIC_SCHOLAR_API_KEY=
NCBI_API_KEY=

# Qdrant (local by default)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# Local LLM server
OLLAMA_BASE_URL=http://localhost:11434
VLLM_BASE_URL=http://localhost:8000/v1
VLLM_API_KEY=

