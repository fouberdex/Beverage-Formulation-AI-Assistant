# Local server
# Set NODE_ENV=production in production. Startup then requires Supabase storage,
# server credentials, and an explicit HTTPS CORS allowlist.
# NODE_ENV=production
HOST=127.0.0.1
PORT=3001
CORS_ORIGINS=http://localhost:5173
RATE_LIMIT_MAX=200
BODY_LIMIT_BYTES=1048576
REQUEST_TIMEOUT_MS=30000
LOG_LEVEL=info
# Comma-separated IP/CIDR list for load balancers that may set forwarded headers.
# TRUST_PROXY=10.0.0.0/8
# Required in production. Use a random value of at least 32 characters.
# METRICS_TOKEN=replace-with-a-long-random-metrics-token

# Durable local JSON storage is for loopback development only. Set
# PERSIST_DATA=false for ephemeral runs.
PERSIST_DATA=true
# DATA_FILE=./data/app-data.json

# Supabase database and Auth. The secret key must remain server-side.
# STORAGE_MODE=supabase
# SUPABASE_URL=https://your-project-ref.supabase.co
# SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace-me
# SUPABASE_SECRET_KEY=sb_secret_replace-me
# Exact Auth email allowed to claim the one-time administrator bootstrap.
# BOOTSTRAP_ADMIN_EMAIL=admin@example.com

# Optional free-tier AI review for target-based predictive formulations.
# Create a key in Google AI Studio, then uncomment GEMINI_API_KEY.
# GEMINI_API_KEY=replace-with-your-google-ai-studio-key
GEMINI_MODEL=gemini-2.5-flash-lite
GEMINI_TIMEOUT_MS=30000
AI_DAILY_REQUEST_LIMIT=25
AI_MONTHLY_REQUEST_LIMIT=250

# External provider processing is opt-in per account. The application stores
# usage counts and token metadata, never provider prompts or responses.

# Optional. When set, API clients must send this value in the x-api-key header.
# API_KEY=replace-with-a-long-random-value

# Optional direct PostgreSQL tooling for migrations/administration.
# DATABASE_URL=postgresql://postgres:password@db.your-project-ref.supabase.co:5432/postgres
# DB_SSL=true
# DB_POOL_MAX=10
DB_HOST=localhost
DB_PORT=5432
DB_NAME=beverageai_dz
DB_USER=postgres
DB_PASSWORD=change-me
