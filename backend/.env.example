# Local server
HOST=127.0.0.1
PORT=3001
CORS_ORIGINS=http://localhost:5173
RATE_LIMIT_MAX=200

# Durable local JSON storage. Set PERSIST_DATA=false for ephemeral runs.
PERSIST_DATA=true
# DATA_FILE=./data/app-data.json

# Optional free-tier AI review for target-based predictive formulations.
# Create a key in Google AI Studio, then uncomment GEMINI_API_KEY.
# GEMINI_API_KEY=replace-with-your-google-ai-studio-key
GEMINI_MODEL=gemini-2.5-flash-lite
GEMINI_TIMEOUT_MS=30000

# Optional. When set, API clients must send this value in the x-api-key header.
# API_KEY=replace-with-a-long-random-value

# PostgreSQL tooling (the default development server currently uses mock storage)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=beverageai_dz
DB_USER=postgres
DB_PASSWORD=change-me
