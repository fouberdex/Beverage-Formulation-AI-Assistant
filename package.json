{
  "name": "beverageai-dz",
  "version": "1.0.0",
  "description": "Enterprise-grade AI beverage formulation platform",
  "private": true,
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev --workspace=backend\" \"npm run dev --workspace=frontend\"",
    "build": "npm run build --workspace=backend && npm run build --workspace=frontend",
    "test": "npm run test --workspace=backend",
    "test:e2e": "node scripts/run-e2e.mjs",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset --local",
    "test:rls": "supabase test db --local supabase/tests/database",
    "test:db": "npm run db:reset && npm run test:rls",
    "install:all": "npm install && npm install --workspace=backend && npm install --workspace=frontend"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.62.1",
    "concurrently": "^8.2.2",
    "supabase": "2.114.0"
  }
}
