# Leave empty during local development to use Vite's /api proxy.
VITE_API_BASE_URL=/api/v1

# Required only when backend API_KEY is enabled.
# VITE_API_KEY=replace-with-the-same-value

# Supabase Auth. Publishable keys are designed for public clients.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace-me
